{
  "name": "fontlens",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "harness": "python3 -m http.server 5173 --directory test/harness",
    "build:icons": "node build/render-icons.js",
    "build:zip": "node build/package.js",
    "build:store": "node build/render-store-assets.js",
    "build": "npm run build:icons && npm run build:zip",
    "audit:bundle": "node build/audit-bundle.js dist/fontlens-1.0.0.zip",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "archiver": "^7.0.1",
    "happy-dom": "^20.9.0",
    "vitest": "^4.1.7"
  }
}
